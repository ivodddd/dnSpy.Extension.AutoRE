<UserControl x:Class="dnSpy.AutoRE.UI.AnalyzeToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource EnvironmentBackgroundBrush}"
             Foreground="{DynamicResource SystemColorsControlText}"
             d:DesignHeight="400" d:DesignWidth="800">
	<UserControl.Resources>
		<!-- The standard ListView/GridView styles don't use the dnSpy theme colors -->
		<Style TargetType="{x:Type ListView}">
			<Setter Property="Background" Value="{DynamicResource ListBoxBackground}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemColorsControlText}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ListBoxBorder}" />
			<Setter Property="BorderThickness" Value="1" />
		</Style>
		<Style TargetType="{x:Type ListViewItem}">
			<Setter Property="Foreground" Value="{DynamicResource SystemColorsControlText}" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource ListBoxItem.MouseOver.Background}" />
				</Trigger>
				<Trigger Property="IsSelected" Value="True">
					<Setter Property="Background" Value="{DynamicResource ListBoxItem.SelectedActive.Background}" />
				</Trigger>
			</Style.Triggers>
		</Style>
		<Style TargetType="{x:Type GridViewColumnHeader}">
			<Setter Property="Background" Value="{DynamicResource ToolBarHorizontalBackground}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemColorsControlText}" />
			<Setter Property="BorderBrush" Value="{DynamicResource ListBoxBorder}" />
			<Setter Property="BorderThickness" Value="0,0,1,1" />
			<Setter Property="Padding" Value="6,3" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
		</Style>
		<Style TargetType="{x:Type StatusBar}">
			<Setter Property="Background" Value="{DynamicResource EnvironmentBackgroundBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemColorsControlText}" />
		</Style>
		<Style TargetType="{x:Type StatusBarItem}">
			<Setter Property="Foreground" Value="{DynamicResource SystemColorsControlText}" />
		</Style>
	</UserControl.Resources>
	<DockPanel>
		<Border DockPanel.Dock="Top" Background="{DynamicResource EnvironmentCommandBar}" Padding="4,3">
			<StackPanel Orientation="Horizontal">
				<Button Content="Analyze" Command="{Binding AnalyzeCommand}" Padding="10,2" />
				<Button Content="Apply renames" Command="{Binding ApplyCommand}" Padding="10,2" Margin="4,0,0,0" />
				<Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,2" Margin="4,0,0,0" />
				<Button Content="Export..." Command="{Binding ExportCommand}" Padding="10,2" Margin="4,0,0,0" />
				<Rectangle Width="1" Margin="6,2" Fill="{DynamicResource ToolBarSeparatorFill}" />
				<CheckBox Content="Wrappers only" IsChecked="{Binding OnlyWrappers}" VerticalAlignment="Center" Margin="4,0" />
				<CheckBox Content="Include non-private" IsChecked="{Binding IncludeNonPrivate}" VerticalAlignment="Center" Margin="4,0"
						  ToolTip="Renaming public/protected methods can break other assemblies that reference them" />
			</StackPanel>
		</Border>
		<StatusBar DockPanel.Dock="Bottom">
			<StatusBarItem>
				<TextBlock Text="{Binding Status}" Foreground="{DynamicResource SystemColorsControlText}" />
			</StatusBarItem>
		</StatusBar>
		<ListView x:Name="resultsListView"
				  ItemsSource="{Binding RowsView}"
				  SelectionMode="Single"
				  MouseDoubleClick="ResultsListView_MouseDoubleClick"
				  VirtualizingPanel.IsVirtualizing="True"
				  VirtualizingPanel.VirtualizationMode="Recycling">
			<ListView.View>
				<GridView>
					<GridViewColumn Width="34">
						<GridViewColumn.CellTemplate>
							<DataTemplate>
								<CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
							</DataTemplate>
						</GridViewColumn.CellTemplate>
					</GridViewColumn>
					<GridViewColumn Header="Current name" Width="190" DisplayMemberBinding="{Binding CurrentName}" />
					<GridViewColumn Header="Proposed name" Width="200" DisplayMemberBinding="{Binding ProposedName}" />
					<GridViewColumn Header="Tags" Width="150" DisplayMemberBinding="{Binding TagsText}" />
					<GridViewColumn Header="Access" Width="80" DisplayMemberBinding="{Binding Accessibility}" />
					<GridViewColumn Header="Type" Width="220" DisplayMemberBinding="{Binding TypeFullName}" />
					<GridViewColumn Header="APIs" Width="420" DisplayMemberBinding="{Binding ApisText}" />
				</GridView>
			</ListView.View>
			<ListView.GroupStyle>
				<GroupStyle>
					<GroupStyle.HeaderTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Name}" FontWeight="Bold" Margin="2,6,0,2"
									   Foreground="{DynamicResource SystemColorsControlText}" />
						</DataTemplate>
					</GroupStyle.HeaderTemplate>
				</GroupStyle>
			</ListView.GroupStyle>
		</ListView>
	</DockPanel>
</UserControl>
